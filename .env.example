DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Compatibility setting only: runtime always uses deepseek-flash (4.1 Flash).
DEEPSEEK_MODEL=deepseek-flash
PORT=3000
HOST=127.0.0.1
PI_TIMEOUT_MS=600000
PI_MAX_TOKENS=98304
# Legacy /api/jobs only. The two-stage workflow always audits both stages.
PI_AUTO_REVIEW=1
MAX_UPLOAD_MB=25
# Optional explicit path to pdftotext / pdftoppm (Poppler must be installed)
# PDFTOTEXT_PATH=C:/tools/poppler/Library/bin/pdftotext.exe
# PDFTOPPM_PATH=C:/tools/poppler/Library/bin/pdftoppm.exe
# PDFINFO_PATH=C:/tools/poppler/Library/bin/pdfinfo.exe
# Python 3.10+ with requirements-pdf.txt installed (vector table structure)
# PYTHON_PATH=C:/tools/python/python.exe
